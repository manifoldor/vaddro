# ==============================================================================
# Vaddro - Worker Configuration Template
# Copy to config/miner.env before first use. Keep operator values private.
# ==============================================================================

# 128-hex uncompressed secp256k1 public key from offline `python seed.py`.
PUBLIC_KEY="REPLACE_WITH_YOUR_128_HEX_PUBLIC_KEY"

# Choose exactly one search mode.
# X/x/. are wildcards in a 40-character exact pattern.
PATTERN=""
# Or search addresses whose first and last N characters are the same (1..8).
SAME_CHAR_ENDS=0

# Applies to both modes: 0=unlimited, 1=first verified hit, N=N verified hits.
MAX_HITS=1

# Stable worker label used in result metadata and logs.
# Leave empty to use <hostname>-gpu<GPU_INDEX>.
WORKER_ID=""

# Deterministic multi-worker partitioning. Use unique zero-based indices on
# workers sharing the same public key; SHARD_COUNT must be a power of two.
SHARD_INDEX=0
SHARD_COUNT=1

# GPU tuning.
WORK_SIZE=224
INVERSE_MULTIPLE=32768
INVERSE_SIZE=255
STREAMS=8
CANARY_INTERVAL=10000
GPU_INDEX=0
EXTRA_FLAGS=""
